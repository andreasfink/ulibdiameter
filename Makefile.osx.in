PROJECT_NAME=@PROJECT_NAME@
VERSION=`cat VERSION`
PROJECT_ID=me.fink.@PROJECT_NAME@

CC=@CC@

all:
	./codesign_environment.sh
	xcodebuild ${XCODESIGN} -target ulibdiameter
	xcodebuild ${XCODESIGN} -target diameter-cmd-gen
	xcodebuild ${XCODESIGN} -target diameter-avp-gen
	
unlock:
	security unlock-keychain ~/Library/Keychains/login.keychain

clean:
	./codesign_environment.sh
	xcodebuild ${XCODESIGN} clean -target ulibdiameter
	xcodebuild ${XCODESIGN} clean -target diameter-cmd-gen
	xcodebuild ${XCODESIGN} clean -target diameter-avp-gen
install:
	./codesign_environment.sh
	xcodebuild ${XCODESIGN} install -target ulibdiameter
	xcodebuild ${XCODESIGN} install -target diameter-cmd-gen
	xcodebuild ${XCODESIGN} install -target diameter-avp-gen

install_for_pkg: 
	xcodebuild DSTROOT="install_root" install

install_root_prepare:
	-rm -rf install_root
	mkdir -p install_root
	xcodebuild DSTROOT="install_root" install -target ulibdiameter
	xcodebuild DSTROOT="install_root" install -target diameter-cmd-gen
	xcodebuild DSTROOT="install_root" install -target diameter-avp-gen


pkg:	install_root_prepare
	./make_pkg.sh "$(PROJECT_NAME)" "$(PROJECT_ID)" install_root "`cat VERSION`" 

pkg2: install_root_prepare
	./make_pkg.sh "$(PROJECT_NAME)" "$(PROJECT_ID)" install_root "`cat VERSION`" "$(PROJECT_NAME).pkg"
